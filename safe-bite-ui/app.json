{
  "expo": {
    "name": "safe-bite-ui",
    "slug": "safe-bite-ui",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safebiteui",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.olwethumtwazi.safebiteui"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50839beb-00ef-42ff-9c47-1d2b9a75fc2e"
      }
    },
    "owner": "olwethumtwazi"
  }
}