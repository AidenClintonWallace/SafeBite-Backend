{
  "expo": {
    "name": "safe-bite-ui",
    "slug": "safe-bite-ui",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "safebiteui",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/safebiteLogo.png",
    "splash": {
      "image": "./assets/safebiteLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c7a43"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/safebiteLogo.png",
        "backgroundColor": "#0c7a43"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.olwethumtwazi.safebiteui"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SafeBite to access your camera to scan barcodes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "50839beb-00ef-42ff-9c47-1d2b9a75fc2e"
      }
    },
    "owner": "olwethumtwazi"
  }
}